+            const bool hole = (x / 3 + y / 5) % 3 == 0;
+            p[0] = hole ? 0 : uint8_t(x * 6 + rnd() % 9);
+            p[1] = hole ? 0 : uint8_t(y * 8 + rnd() % 9);
