+                const int a = int(rnd() & 31), b = int(rnd() & 31);
+                c0[c] = a << 3 | a >> 2;
+                c1[c] = b << 3 | b >> 2;
+            }
+            for (int y = 0; y < 4; y++)
+                for (int x = 0; x < 4; x++) {
+                    const int px = bx * 4 + x, py = by * 4 + y, i = int(rnd() & 3);
